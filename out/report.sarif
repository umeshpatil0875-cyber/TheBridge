          "ruleId": "trivy/DS-0002",
          "level": "error",
          "message": {
            "text": "Image user should not be 'root'. Running containers with 'root' user can lead to a container escape situation. It is a best practice to run containers as non-root users, which can be done by adding a 'USER' statement to the Dockerfile. Fix: Add 'USER <non root user name>' line to the Dockerfile"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                }
              }
            }
          ],
          "partialFingerprints": {
